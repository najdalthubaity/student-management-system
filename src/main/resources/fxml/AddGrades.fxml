<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
 <?import javafx.scene.control.ComboBox?>

<AnchorPane 
            prefHeight="400.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26" 
            xmlns:fx="http://javafx.com/fxml/1"
fx:controller="com.finalproject.AddGradesController">

    <children>

        <Label layoutX="238.0" layoutY="44.0" text="Add Grades">
         <font>
            <Font size="24.0" />
         </font></Label>
         
        

<ComboBox fx:id="studentIdField"
          layoutX="200.0"
          layoutY="120.0"
          prefWidth="220.0" />

       

        <TextField 
            fx:id="gradeField"
            layoutX="200.0" 
            layoutY="175.0" 
            prefWidth="220.0"
            promptText="Grade" />

        <Button
            layoutX="290.0" 
            layoutY="240.0"
            onAction="#saveGrade" 
            text="Save" />

        <Label
            fx:id="resultLabel" 
            
            layoutX="200.0" layoutY="300.0" />
      <Button
          layoutX="36.0"
          layoutY="355.0"
          onAction="#back" 
          text="Back" />

    </children>

</AnchorPane>
