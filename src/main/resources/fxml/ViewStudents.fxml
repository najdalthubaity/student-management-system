<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finalproject.ViewStudentsController">

    <children>

     
        <Label layoutX="210.0" layoutY="20.0" text="View Students">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>

      
        <ComboBox fx:id="idStudent"
                  layoutX="200.0"
                  layoutY="100.0"
                  prefWidth="200.0"
                  promptText="Select Student ID" />

        <!-- Show Button -->
        <Button layoutX="260.0"
                layoutY="150.0"
                text="Show"
                onAction="#showStudent" />

      
        <Label fx:id="resultLabel"
               layoutX="120.0"
               layoutY="220.0"
               prefWidth="350.0"
               style="-fx-font-size: 14px;" />

     
        <Button layoutX="20.0"
                layoutY="350.0"
                text="Back"
                onAction="#back" />

    </children>

</AnchorPane>